# 静的ファイルをブラウザに長期キャッシュさせる (イベント会場のモバイル回線対策)。
#
# 商品画像は PHP 側で「?v=更新日時」付きの URL で参照しているため (asset_url())、
# 同じファイル名で差し替えても URL が変わり、新しい画像が読み込まれる。
# そのため画像は 1 年間・再検証なし (immutable) でキャッシュさせる。
# cart.js も「?v=更新日時」付きで読み込んでいる。Bootstrap などバージョン付き URL に
# していない CSS/JS もあるため、CSS/JS のキャッシュは 30 日にとどめる。

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg    "access plus 1 year"
    ExpiresByType image/png     "access plus 1 year"
    ExpiresByType image/gif     "access plus 1 year"
    ExpiresByType image/webp    "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css               "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript        "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|gif|webp|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
